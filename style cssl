*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#0f172a;
    color:white;
}

/* NAVBAR */

header{
    position:absolute;
    width:100%;
    top:0;
    left:0;
    z-index:100;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:25px 8%;
}

.logo{
    font-size:38px;
    font-weight:800;
}

.logo span{
    color:#0066ff;
}

nav{
    display:flex;
    gap:30px;
}

nav a{
    text-decoration:none;
    color:white;
    transition:.3s;
}

nav a:hover{
    color:#0066ff;
}

.auth{
    display:flex;
    gap:10px;
}

.login,
.signup{
    padding:12px 24px;
    border:none;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
}

.login{
    background:transparent;
    border:1px solid rgba(255,255,255,.3);
    color:white;
}

.signup{
    background:#0066ff;
    color:white;
}

/* HERO */

.hero{
    height:100vh;

    background:
    url("hero.jpg")
    center center/cover no-repeat;

    position:relative;

    display:flex;
    align-items:center;

    padding:0 8%;
}

.overlay{
    position:absolute;
    inset:0;

    background:
    linear-gradient(
    90deg,
    rgba(15,23,42,.85),
    rgba(15,23,42,.45)
    );
}

.hero-content{
    position:relative;
    z-index:2;
    max-width:900px;
}

.location{
    letter-spacing:3px;
    color:#cbd5e1;
    margin-bottom:20px;
}

h1{
    font-size:80px;
    line-height:1;
    font-weight:800;
}

h1 span{
    color:#0066ff;
}

.subtitle{
    margin-top:25px;
    max-width:700px;
    font-size:20px;
    color:#e2e8f0;
}

/* BOOKING BOX */

.booking-box{
    background:rgba(255,255,255,.1);
    backdrop-filter:blur(30px);
    padding:25px;
    margin-top:40px;
    border-radius:25px;
    width:100%;
}

.tabs{
    display:flex;
    gap:10px;
    margin-bottom:20px;
}

.tabs button{
    border:none;
    background:white;
    color:#0f172a;
    padding:12px 20px;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
}

.tabs .active{
    background:#0066ff;
    color:white;
}

.search-grid{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(180px,1fr));

    gap:15px;
}

.search-grid input,
.search-grid select{
    padding:15px;
    border:none;
    border-radius:12px;
}

.search-btn{
    width:100%;
    margin-top:20px;
    border:none;
    padding:18px;
    border-radius:12px;
    font-size:18px;
    font-weight:700;
    color:white;
    cursor:pointer;

    background:
    linear-gradient(
    135deg,
    #0066ff,
    #00c896
    );
}

/* FEATURES */

.features{
    display:flex;
    gap:40px;
    flex-wrap:wrap;
    margin-top:35px;
}

.feature{
    font-size:16px;
    color:white;
}

/* RESPONSIVE */

@media(max-width:768px){

    nav{
        display:none;
    }

    h1{
        font-size:50px;
    }

    .subtitle{
        font-size:18px;
    }

    .features{
        gap:20px;
    }

}
